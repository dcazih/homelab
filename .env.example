# Run `id -u` and `id -g` on your Mac; paste actual values here.
HOST_UID=501
HOST_GID=20
HOST_MUSIC_ROOT=/path/to/Music
TZ=America/Toronto
AIRVPN_COUNTRY=Canada

# Obtain these from AirVPN's WireGuard Config Generator.
# Choose the SAME AirVPN device to which you assigned forwarded port 32740.
# Keep this .env private. Use the IPv4 address only if Docker IPv6 is disabled.
AIRVPN_WG_PRIVATE_KEY=REPLACE_FROM_AIRVPN
AIRVPN_WG_PRESHARED_KEY=REPLACE_FROM_AIRVPN
AIRVPN_WG_ADDRESSES=10.x.x.x/32
